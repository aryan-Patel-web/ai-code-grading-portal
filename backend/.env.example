# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get from: Atlas → Connect → Drivers → copy the connection string
# Replace <user>, <password>, <cluster> with your values
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kpmg-portal?retryWrites=true&w=majority

# ─── Mistral AI ───────────────────────────────────────────────────────────────
# Get from: https://console.mistral.ai/ → API Keys
MISTRAL_API_KEY=your_mistral_api_key_here
# Available models: mistral-small-latest | mistral-medium-latest | mistral-large-latest
MISTRAL_MODEL=mistral-small-latest

# ─── Sandbox ──────────────────────────────────────────────────────────────────
# Max milliseconds a student's code may run before the container is killed
SANDBOX_TIMEOUT_MS=10000
